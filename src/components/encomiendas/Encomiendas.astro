---
import { withBase } from "@/utils/withBase";
import ArrowImageBanner from "@/components/ArrowImageBanner.astro";
import PageTitleHeader from "@/components/PageTitleHeader.astro";
import {
	getEncomiendasProvinces,
	getLocationDisplayTitle,
} from "@/data/puntosDeVenta";

const encomiendasProvinces = getEncomiendasProvinces();
---

<section class="relative overflow-hidden pt-28 pb-10 sm:pt-32 sm:pb-12 lg:pt-36 lg:pb-16">
	<!-- Rombo de fondo -->
	<div
		class="pointer-events-none absolute inset-0 overflow-hidden"
		aria-hidden="true"
	>
		<img
			src={withBase("/images/shapes/shape-diamond-bg.svg")}
			alt="rombo de fondo azul"
			loading="lazy"
			class="absolute top-[72%] left-0 h-[110vh] w-auto max-w-none translate-x-[-70%] -translate-y-1/2 select-none sm:top-[66%] sm:left-10 sm:h-[115vh] lg:hidden"
		/>
		<img
			src={withBase("/images/shapes/shape-diamond-bg.svg")}
			alt="rombo de fondo azul"
			loading="lazy"
			class="absolute top-1/2 left-0 hidden h-[200vh] w-auto max-w-none translate-x-[-56%] -translate-y-1/2 select-none lg:block xl:h-[300vh] 2xl:translate-x-[-40%]"
		/>
	</div>

	<ArrowImageBanner
		id="encomiendas-banner"
		image={withBase("/images/encomiendas/encomiendas.webp")}
		imageAlt="Gestión de encomiendas de LA UNION S.R.L."
		align="end"
	>
		<h1
			class="text-left text-lg sm:text-2xl md:text-3xl xl:text-4xl"
			data-aos="fade-left"
			data-aos-duration="800"
			data-aos-delay="200"
		>
			Tus envíos viajan <br class="hidden sm:block" />
			con la confianza <br class="hidden sm:block" />
			de siempre.
		</h1>
	</ArrowImageBanner>

	<p
		class="relative z-10 mx-auto mt-6 max-w-4xl px-4 text-center text-sm font-semibold text-gray-900 sm:mt-8 sm:text-base lg:text-lg"
		data-aos="fade-up"
		data-aos-duration="800"
	>
		Entregas ágiles, seguras y sin complicaciones, para que tus encomiendas
		lleguen a destino con la tranquilidad de estar en buenas manos.
	</p>

	<!-- Puntos de entrega y retiro -->
	<div class="relative z-10 mt-10 sm:mt-12 lg:mt-16">
		<PageTitleHeader
			title="Puntos de entrega y retiro"
			id="encomiendas-puntos-header"
		/>
	</div>

	<div class="relative z-10 container mx-auto max-w-7xl px-4">
		{
			encomiendasProvinces.map((province, provinceIndex) => (
				<section class="mb-10 last:mb-0 sm:mb-12 lg:mb-14">
					<div
						class="relative mb-6 inline-flex h-12 min-w-56 items-center sm:mb-8 sm:h-14 sm:min-w-64 md:min-w-80 lg:min-w-96"
						data-aos="fade-right"
						data-aos-duration="800"
						data-aos-delay={provinceIndex * 100}
					>
						<img
							src={withBase("/images/shapes/arrow-right-large-blue.svg")}
							alt="flecha grande azul para el punto de venta"
							class="absolute inset-0 h-full w-full object-fill"
							aria-hidden="true"
							loading="lazy"
						/>
						<h2
							class="relative z-10 pl-6 pr-14 text-xl font-bold text-white sm:pl-8 sm:pr-16 sm:text-2xl md:text-3xl"
						>
							{province.name}
						</h2>
					</div>

					<ul
						class="grid grid-cols-1 gap-x-8 gap-y-6 sm:gap-x-10 sm:gap-y-7 md:grid-cols-2 lg:gap-x-14"
					>
						{
							province.locations.map((location, index) => (
								<li
									class="flex items-start gap-3 sm:gap-4"
									data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
									data-aos-duration="800"
									data-aos-delay={100 + index * 75}
								>
									<img
										src={withBase("/images/icons/icon-disc.svg")}
										alt="icono de disco para el punto de venta"
										class="mt-1.5 size-3 shrink-0 sm:mt-2 sm:size-3.5"
										aria-hidden="true"
										loading="lazy"
									/>
									<div class="space-y-0.5 text-sm text-gray-900 sm:text-base">
										<p class="font-bold">
											{getLocationDisplayTitle(location.title)}
										</p>
										{
											location.details.map((detail) => (
												<p class="font-medium">{detail}</p>
											))
										}
									</div>
								</li>
							))
						}
					</ul>
				</section>
			))
		}
	</div>

	<!-- Texto inferior -->
	<div
		class="relative z-10 container mx-auto mt-10 max-w-7xl px-4 sm:mt-12 lg:mt-16"
	>
		<h2
			class="text-2xl font-bold tracking-wide text-launion uppercase sm:text-3xl lg:text-4xl"
			data-aos="fade-right"
			data-aos-duration="800"
		>
			Servicio diario de encomiendas
		</h2>
		<div
			class="mt-4 max-w-4xl space-y-3 text-sm font-medium text-gray-900 sm:mt-5 sm:text-base lg:text-lg"
		>
			<p
				data-aos="fade-right"
				data-aos-duration="800"
				data-aos-delay="150"
			>
				Conectamos distintas ciudades a través de un servicio diario de
				encomiendas, brindando rapidez, seguridad y una gestión eficiente en
				cada envío.
			</p>
			<p
				data-aos="fade-right"
				data-aos-duration="800"
				data-aos-delay="300"
			>
				En La Unión SRL trabajamos con el mismo compromiso y responsabilidad que
				nos acompaña desde hace más de 50 años, conectando personas, destinos y
				oportunidades.
			</p>
		</div>
	</div>
</section>
