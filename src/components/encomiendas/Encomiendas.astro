---
import ArrowImageBanner from "@/components/ArrowImageBanner.astro";
import { ADDRESS, MAP_IFRAME } from "astro:env/server";
import { EMAIL } from "astro:env/client";
import { getEncomiendasProvinces } from "@/data/puntosDeVenta";

const encomiendasProvinces = getEncomiendasProvinces();
const emailHref = EMAIL ? `mailto:${EMAIL}` : undefined;
---

<section class="relative overflow-hidden pt-28 pb-10 sm:pt-32 sm:pb-12 lg:pt-36 lg:pb-16">
	<!-- Rombo de fondo -->
	<div
		class="pointer-events-none absolute inset-0 overflow-hidden"
		aria-hidden="true"
	>
		<img
			src="/images/shapes/shape-diamond-bg.svg"
			alt="rombo de fondo azul"
			loading="lazy"
			class="absolute top-[72%] left-0 h-[110vh] w-auto max-w-none translate-x-[-70%] -translate-y-1/2 select-none sm:top-[66%] sm:left-10 sm:h-[115vh] lg:hidden"
		/>
		<img
			src="/images/shapes/shape-diamond-bg.svg"
			alt="rombo de fondo azul"
			loading="lazy"
			class="absolute top-1/2 left-0 hidden h-[200vh] w-auto max-w-none translate-x-[-56%] -translate-y-1/2 select-none lg:block xl:h-[300vh] 2xl:translate-x-[-40%]"
		/>
	</div>

	<ArrowImageBanner
		id="encomiendas-banner"
		image="/images/encomiendas/encomiendas.webp"
		imageAlt="Gestión de encomiendas de LA UNION S.R.L."
		align="end"
	>
		<h1
			class="text-left text-lg sm:text-2xl md:text-3xl xl:text-4xl"
			data-aos="fade-left"
			data-aos-duration="800"
			data-aos-delay="200"
		>
			Tus envíos viajan <br class="hidden sm:block" />
			con la confianza <br class="hidden sm:block" />
			de siempre.
		</h1>
	</ArrowImageBanner>

	<p
		class="relative z-10 mx-auto mt-6 max-w-4xl px-4 text-center text-sm font-semibold text-gray-900 sm:mt-8 sm:text-base lg:text-lg"
		data-aos="fade-up"
		data-aos-duration="800"
	>
		Entregas ágiles, seguras y sin complicaciones, para que tus encomiendas
		lleguen a destino con la tranquilidad de estar en buenas manos.
	</p>

	<!-- Puntos de venta + mapa -->
	<div class="relative z-10 mt-10 sm:mt-12 lg:mt-16">
		<div class="relative mx-auto max-w-7xl">
			<div
				class="pointer-events-none absolute inset-y-0 right-0 left-[calc(50%-50vw)] rounded-r-3xl bg-launion xl:rounded-r-[2.5rem]"
				aria-hidden="true"
			></div>

			<div
				class="relative z-10 grid grid-cols-1 gap-8 px-5 py-8 sm:px-8 sm:py-10 lg:grid-cols-2 lg:items-start lg:gap-10 lg:px-10 lg:py-12 xl:gap-14"
			>
				<div
					class="flex flex-col gap-6 sm:gap-8"
					data-aos="fade-right"
					data-aos-duration="800"
					data-aos-delay="100"
				>
					<div>
						<h2
							class="text-xl font-bold tracking-wide text-white uppercase sm:text-2xl"
						>
							Puntos de entrega y retiro
						</h2>
						<p class="mt-2 text-sm font-medium text-white/80 sm:text-base">
							Encontrá el punto más cercano para enviar o retirar tu encomienda.
						</p>
					</div>

					{
						encomiendasProvinces.map((province, provinceIndex) => (
							<section>
								<h3
									class="mb-3 border-b border-white/20 pb-2 text-sm font-bold tracking-wider text-white uppercase sm:text-base"
									data-aos="fade-right"
									data-aos-duration="800"
									data-aos-delay={150 + provinceIndex * 75}
								>
									{province.name}
								</h3>
								<ul class="space-y-3">
									{province.locations.map((location, index) => (
										<li
											class="rounded-xl bg-white/10 px-4 py-3 backdrop-blur-sm sm:px-5 sm:py-4"
											data-aos="fade-right"
											data-aos-duration="800"
											data-aos-delay={200 + provinceIndex * 75 + index * 50}
										>
											<p class="text-sm font-bold text-white sm:text-base">
												{location.title}
											</p>
											<div class="mt-1 space-y-0.5">
												{location.details.map((detail) => (
													<p class="text-xs font-medium text-white/90 sm:text-sm">
														{detail}
													</p>
												))}
											</div>
										</li>
									))}
								</ul>
							</section>
						))
					}

					<a
						href="/puntos-de-venta"
						class="inline-flex items-center gap-2 self-start text-sm font-semibold text-white underline-offset-4 transition-opacity hover:opacity-80 hover:underline sm:text-base"
					>
						Ver todos los puntos de venta
						<span aria-hidden="true">→</span>
					</a>
				</div>

				<div class="flex flex-col gap-5 lg:sticky lg:top-32">
					<div
						class="aspect-square w-full overflow-hidden rounded-2xl bg-white/10 sm:aspect-4/3 lg:aspect-square"
						data-aos="fade-left"
						data-aos-duration="800"
					>
						{
							MAP_IFRAME && (
								<iframe
									src={MAP_IFRAME}
									title="Ubicación de LA UNION S.R.L. en Google Maps"
									class="h-full w-full border-0"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								></iframe>
							)
						}
					</div>
					<div
						class="space-y-1 text-sm font-medium text-white sm:text-base"
						data-aos="fade-left"
						data-aos-duration="800"
						data-aos-delay="150"
					>
						{
							emailHref && EMAIL && (
								<a
									href={emailHref}
									class="block transition-opacity hover:opacity-80"
								>
									{EMAIL}
								</a>
							)
						}
						{ADDRESS && <p>{ADDRESS}</p>}
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Texto inferior -->
	<div
		class="relative z-10 container mx-auto mt-10 max-w-7xl px-4 sm:mt-12 lg:mt-16"
	>
		<h2
			class="text-2xl font-bold tracking-wide text-launion uppercase sm:text-3xl lg:text-4xl"
			data-aos="fade-right"
			data-aos-duration="800"
		>
			Servicio diario de encomiendas
		</h2>
		<div
			class="mt-4 max-w-4xl space-y-3 text-sm font-medium text-gray-900 sm:mt-5 sm:text-base lg:text-lg"
		>
			<p
				data-aos="fade-right"
				data-aos-duration="800"
				data-aos-delay="150"
			>
				Conectamos distintas ciudades a través de un servicio diario de
				encomiendas, brindando rapidez, seguridad y una gestión eficiente en
				cada envío.
			</p>
			<p
				data-aos="fade-right"
				data-aos-duration="800"
				data-aos-delay="300"
			>
				En La Unión SRL trabajamos con el mismo compromiso y responsabilidad que
				nos acompaña desde hace más de 50 años, conectando personas, destinos y
				oportunidades.
			</p>
		</div>
	</div>
</section>
